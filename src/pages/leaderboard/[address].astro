---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import TraderDetailReact from "../../components/TraderDetailReact.tsx";

// Use server-side rendering for dynamic addresses
export const prerender = false;

const { address } = Astro.params;

if (!address) {
  throw new Error("Address parameter is required");
}

// Type assertion to help TypeScript understand address is defined
const traderAddress = address as string;
---

<Layout
  title={`Trader ${traderAddress.slice(0, 6)}...${traderAddress.slice(-4)} | Purro Leaderboard`}
>
  <Header />
  <TraderDetailReact client:load address={traderAddress} />
  <Footer />
</Layout>
