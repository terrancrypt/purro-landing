---
import xIcon from "../assets/xIcon.svg";
import discordIcon from "../assets/discordIcon.svg";
import telegramIcon from "../assets/teleIcon.svg";
import Button from "./Button";
import { BookTextIcon, Trophy } from "@lucide/astro";

const socials = [
  {
    icon: xIcon.src,
    url: "https://x.com/purro_xyz",
    isFileIcon: false,
  },
  {
    icon: discordIcon.src,
    url: "https://discord.gg/TxvDwvfMTv",
    isFileIcon: false,
  },
  {
    icon: telegramIcon.src,
    url: "https://t.me/purro_xyz",
    isFileIcon: false,
  },
  {
    url: "https://docs.purro.xyz",
    isFileIcon: true,
  },
];
---

<header
  class="fixed top-0 left-1/2 max-w-6xl transform -translate-x-1/2 w-full container mx-auto mt-6 px-2 z-50"
>
  <div
    class="p-3 flex justify-between items-center bg-[#b1cac4]/30 rounded-full backdrop-blur-sm"
  >
    <a href="/">
      <img src="/Purro_Icon_Dark.png" alt="logo" class="h-10 rounded-full" />
    </a>
    <div class="flex items-center gap-2">
      <a
        href="/leaderboard"
        class="hover:underline p-2 rounded-full transition-all duration-300 text-white"
        title="Leaderboard"
      >
        Leaderboard
      </a>
      <a
        href="https://docs.purro.xyz"
        target="_blank"
        class="hover:underline p-2 rounded-full transition-all duration-300 text-white"
        title="Documentation"
      >
        Docs
      </a>
      <a href="/install">
        <Button client:load> Install </Button>
      </a>
    </div>
  </div>
</header>

<style>
  /* Fixed header specific styles */
  .fixed {
    position: fixed;
  }

  /* Backdrop blur for better visibility */
  .backdrop-blur-sm {
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* Ensure header stays on top */
  .z-50 {
    z-index: 50;
  }

  /* Mobile adjustments for fixed header */
  @media (max-width: 768px) {
    header {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .container {
      max-width: 100%;
    }
  }

  /* Very small screens */
  @media (max-width: 480px) {
    header {
      margin-top: 0.5rem;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }
</style>
