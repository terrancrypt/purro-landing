---
import chrome from "../assets/chrome.png";
import Button from "./Button";
import AuroraBg from "./AuroraBg";
---

<div class="w-full h-screen overflow-hidden relative">
  <div class="w-full h-full bg-[#081919] z-[1] absolute top-0 left-0">
    <AuroraBg client:load />
  </div>

  <!-- <img
    src={background.src}
    alt="background"
    class="absolute w-full h-full object-cover z-[-1]"
    fetchpriority="high"
  /> -->

  <div class="container mx-auto relative z-[2]">
    <div class="flex flex-col items-center justify-center h-screen">
      <div class="scroll-animate text-center">
        <div class="hero-logo-container">
          <img
            src="/Purro_Logotype_White.png"
            alt="logo"
            class="w-4/5 max-w-xl md:w-full md:max-w-2xl mx-auto hero-logo object-cover"
          />
        </div>
        <p
          class="font-figtree font-medium text-white text-xl sm:text-3xl md:text-5xl leading-tight md:leading-tight hero-tagline"
        >
          Built to chill&nbsp;&mdash;&nbsp;Ready to win
        </p>
      </div>

      <div
        class="absolute bottom-12 flex flex-col items-center scroll-animate delay-500"
      >
        <div class="scroll-animate delay-300">
          <a href="/install">
            <Button isToast={true} className="bg-white hover:bg-white/80">
              <img src={chrome.src} alt="chrome" class="h-8 md:h-10" />
              <span>Download for Chrome</span>
            </Button>
          </a>
        </div>

        <!-- <p
          class="max-w-2xl text-center text-sm md:text-md font-light mt-5 text-[#b1cac4]"
        >
          Built for real onchain grinders: smooth UX, unified assets. <br />
          40% fees come back to you.
        </p> -->
      </div>
    </div>
  </div>
</div>

<style>
  .hero-logo-container {
    opacity: 0;
    transform: scale(0.8) translateY(20px);
    animation: heroLogoEnter 1.2s ease-out 0.3s forwards;
  }

  .hero-tagline {
    opacity: 0;
    transform: translateY(20px);
    animation: heroTaglineEnter 1s ease-out 0.8s forwards;
  }

  @keyframes heroLogoEnter {
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  @keyframes heroTaglineEnter {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Prevent flash of large logo on initial load */
  .hero-logo {
    max-height: 0;
    overflow: hidden;
    animation: logoReveal 0.6s ease-out 0.5s forwards;
  }

  @keyframes logoReveal {
    to {
      max-height: 200px; /* Adjust based on your logo size */
    }
  }

  /* Mobile optimizations */
  @media (max-width: 768px) {
    .hero-logo-container {
      animation-duration: 1s;
      animation-delay: 0.2s;
    }

    .hero-tagline {
      animation-duration: 0.8s;
      animation-delay: 0.6s;
    }

    .hero-logo {
      animation-delay: 0.3s;
    }

    @keyframes logoReveal {
      to {
        max-height: 150px; /* Smaller on mobile */
      }
    }
  }
</style>
